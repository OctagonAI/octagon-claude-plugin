{
  "extends": "../../transform.config.json",
  "includeSkills": [],
  "excludeSkills": [],
  "substitutions": [
    {
      "find": "Use the `octagon-agent` tool",
      "replace": "Use the `octagon-holdings-agent` tool"
    },
    {
      "find": "\"toolName\": \"octagon-agent\"",
      "replace": "\"toolName\": \"octagon-holdings-agent\""
    },
    {
      "pattern": "^\\*\\*Data Sources?:?\\*\\*:?.*$",
      "flags": "m",
      "replace": "**Data Source:** octagon-holdings-agent"
    },
    {
      "pattern": "\\boctagon-(?!holdings-agent\\b)[a-z][a-z0-9-]*-agent\\b",
      "replace": "octagon-holdings-agent"
    },
    {
      "pattern": "\\boctagon-agent\\b",
      "replace": "octagon-holdings-agent"
    }
  ],
  "forbiddenPatterns": [
    {
      "pattern": "\\b(?:you should|we recommend|investors should)\\b",
      "flags": "i",
      "reason": "the plugin reports data; it holds no view"
    }
  ]
}
