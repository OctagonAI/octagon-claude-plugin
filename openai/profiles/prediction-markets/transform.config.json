{
  "extends": "../../transform.config.json",
  "includeSkills": [
    "prediction-markets-analysis"
  ],
  "excludeSkills": [],
  "forbiddenPatterns": [
    {
      "pattern": "\\b(?:place|placing|make|making) (?:a )?(?:bet|wager)s?\\b",
      "flags": "i",
      "reason": "bet placement is out of scope"
    },
    {
      "pattern": "\\b(?:buy|sell|short|long) (?:yes|no)\\b",
      "flags": "i",
      "reason": "no side recommendations"
    },
    {
      "pattern": "\\b(?:entry|exit) (?:point|price|timing)s?\\b|\\bstake size\\b|\\bpayout\\b",
      "flags": "i",
      "reason": "trade-execution vocabulary; findings stop at the analysis"
    },
    {
      "pattern": "\\b(?:slight|strong|weak) (?:sell|buy)\\b|before positioning",
      "flags": "i",
      "reason": "example output must not recommend a side or timing"
    }
  ]
}
