{
  "excludeSkills": [
    "octagon-api-smoke-test",
    "octagon-setup",
    "prediction-markets-analysis"
  ],
  "removeFiles": [
    "README.md",
    "references/mcp-setup.md"
  ],
  "sections": [
    {
      "heading": "## Prerequisites",
      "body": "This skill uses the Octagon tools. If they are unavailable, ask the user to connect Octagon from the plugin's connection settings, then retry. Never ask the user to paste passwords, access tokens, or other credentials into the conversation."
    }
  ],
  "substitutions": [
    {
      "find": "the Octagon Claude plugin",
      "replace": "Octagon"
    },
    {
      "find": "Octagon Claude plugin",
      "replace": "Octagon"
    },
    {
      "pattern": "^[ \\t]*\"server\": \"octagon-claude-plugin\",\\n",
      "flags": "m",
      "replace": ""
    }
  ],
  "skillEdits": {
    "stock-grades": {
      "substitutions": [
        {
          "file": "references/interpreting-results.md",
          "find": "### Investment Signals",
          "replace": "### Sentiment Signals"
        },
        {
          "file": "references/interpreting-results.md",
          "find": "| Upgrade cluster | Consider buying |",
          "replace": "| Upgrade cluster | Improving analyst sentiment |"
        }
      ]
    },
    "price-target-summary": {
      "substitutions": [
        {
          "file": "references/interpreting-results.md",
          "find": "| Below all targets | Strong buy signal |",
          "replace": "| Below all targets | Trades below every analyst target |"
        },
        {
          "file": "references/interpreting-results.md",
          "find": "### Investment Decision Framework\n\n| Finding | Action |",
          "replace": "### Research Framework\n\n| Finding | Interpretation |"
        },
        {
          "file": "references/interpreting-results.md",
          "find": "| >20% upside, strong consensus | Consider buying |",
          "replace": "| >20% upside, strong consensus | Analysts see significant upside |"
        }
      ]
    },
    "financial-health-scores": {
      "substitutions": [
        {
          "file": "references/interpreting-results.md",
          "find": "| Strong Buy consideration |",
          "replace": "| Strong financial health |"
        },
        {
          "file": "references/interpreting-results.md",
          "find": "| Avoid or distressed only |",
          "replace": "| Elevated distress risk |"
        }
      ]
    },
    "stock-price-change": {
      "sections": [
        {
          "file": "references/interpreting-results.md",
          "heading": "### Position Sizing",
          "body": null
        }
      ],
      "substitutions": [
        {
          "file": "references/interpreting-results.md",
          "find": "| All negative | Avoid or short |",
          "replace": "| All negative | Broad weakness |"
        }
      ]
    },
    "stock-performance": {
      "substitutions": [
        {
          "file": "references/interpreting-results.md",
          "find": "**Risk assess**: Position sizing",
          "replace": "**Risk assess**: Volatility and drawdowns"
