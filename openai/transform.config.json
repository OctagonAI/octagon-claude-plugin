  },
  "forbiddenPatterns": [
    {
      "pattern": "claude",
      "flags": "i",
      "reason": "provider-specific wording must be neutral"
    },
    {
      "pattern": "\\bnpx\\b",
      "reason": "local package installs are not part of the hosted plugin"
    },
    {
      "pattern": "api[ _-]?keys?\\b",
      "flags": "i",
      "reason": "the plugin authenticates with OAuth, not API keys"
    },
    {
      "pattern": "OCTAGON_API_KEY|CLAUDE_PLUGIN_ROOT|claude_desktop_config",
      "reason": "local runtime configuration does not apply"
    },
    {
      "pattern": "octagon-local|\\bmcp_auth\\b",
      "reason": "references a Claude-specific connector flow"
    },
    {
      "pattern": "octagon-setup|octagon-api-smoke-test|octagon-mcp-specialist",
      "reason": "references a component that is not in the OpenAI package"
    },
    {
      "pattern": "\\b(?:strong|consider|no) trade\\b|placing a trade|before trading|pre-trade",
      "flags": "i",
      "reason": "trading recommendations are out of scope"
    },
    {
      "pattern": "consider (?:buying|selling)|strong buy (?:signal|consideration)|avoid or short",
      "flags": "i",
      "reason": "buy/sell recommendations are out of scope"
    },
    {
      "pattern": "position sizing|sizing positions|% of portfolio",
      "flags": "i",
      "reason": "position sizing is personalized advice"
    },
    {
      "pattern": "actionable trading insights",
      "flags": "i",
      "reason": "prediction-market output must be framed as research"
    },
    {
      "pattern": "(?<!octagon )(?:prediction[- ]markets?|kalshi|polymarket)",
      "flags": "i",
      "reason": "prediction-market content belongs to the Octagon Prediction Markets plugin",
      "paths": [
        "skills/get-started/",
        "skills/octagon-research-router/",
        "skills/octagon-status/"
      ],
      "inherit": false
    }
  ]
}
